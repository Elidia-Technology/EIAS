const { Command } = require('commander');
const { CLI } = require('../dist/cli/CLI');
const program = new Command();
const cli = new CLI();

program
  .name('as4')
  .description('AS4 CLI - ActionScript 3/4 for Node.js & browser')
  .version('0.1.0');

program
  .command('compile <file>')
  .option('--watch', 'Watch mode')
  .option('--outDir <dir>', 'Custom output folder')
  .description('Compile .as file to .js')
  .action(async (file, options) => {
    await cli.compile(file, options);
  });

program
  .command('run <file>')
  .description('Compile & run .as file')
  .action(async (file) => {
    await cli.run(file);
  });

program
  .command('test')
  .description('Run AS4 test suite')
  .action(() => {
    cli.runTests();
  });

program
  .command('generate <pattern>')
  .description('Scaffold class, singleton, ai module, etc.')
  .action((pattern) => {
    cli.generate(pattern);
  });

program
  .command('install <pkg>')
  .description('Install AS4 package')
  .action((pkg) => {
    cli.install(pkg);
  });

program
  .command('publish')
  .description('Publish AS4 module')
  .action(() => {
    cli.publish();
  });

program.parse(process.argv);
